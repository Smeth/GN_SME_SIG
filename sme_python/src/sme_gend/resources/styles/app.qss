/* SME Gendarmerie — thème clair institutionnel (bleu nuit + or) */

* {
    font-family: "Segoe UI", "SF Pro Display", Roboto, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f0f2f5;
}

QMenuBar {
    background-color: #1a237e;
    color: #ffffff;
    padding: 4px 8px;
    border: none;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: rgba(255, 215, 0, 0.25);
}

QMenuBar::item:pressed {
    background-color: rgba(255, 215, 0, 0.4);
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d4dc;
    padding: 4px;
}

QMenu::item {
    padding: 8px 28px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #e8eaf6;
    color: #1a237e;
}

QToolButton#sidebarCollapseBtn {
    color: #ffd54f;
    font-weight: bold;
    font-size: 14px;
    padding: 6px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.1);
}

QToolButton#sidebarCollapseBtn:hover {
    background-color: rgba(255, 213, 79, 0.35);
}

QToolButton#sidebarExpandBtn {
    color: #ffd54f;
    font-weight: bold;
    font-size: 16px;
    padding: 8px 4px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.15);
    min-width: 48px;
}

QToolButton#sidebarExpandBtn:hover {
    background-color: rgba(255, 213, 79, 0.4);
}

QToolButton#sidebarHelpBtn {
    color: #ffd54f;
    font-weight: bold;
    font-size: 16px;
    padding: 8px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    min-width: 40px;
    min-height: 40px;
}

QToolButton#sidebarHelpBtn:hover {
    background-color: rgba(255, 213, 79, 0.35);
}

/* Sidebar */
QFrame#sidebarFrame {
    background-color: #1a237e;
    border: none;
    min-width: 260px;
    max-width: 300px;
}

/* Mode réduit (icônes seules) — largeur alignée au code Python */
QFrame#sidebarFrame[compact="true"] {
    min-width: 84px;
    max-width: 100px;
}

QFrame#sidebarFrame[compact="true"] QTreeWidget#navTree {
    padding-left: 2px;
    padding-right: 2px;
}

QFrame#sidebarFrame[compact="true"] QTreeWidget#navTree::item {
    padding: 12px 6px;
    margin: 3px 4px;
}

/* Scrollbar discrète (ne recouvre plus les icônes) */
QFrame#sidebarFrame[compact="true"] QScrollBar:vertical {
    width: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: none;
    border-radius: 2px;
    margin: 2px 0;
}

QFrame#sidebarFrame[compact="true"] QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.32);
    border-radius: 2px;
    min-height: 36px;
}

QFrame#sidebarFrame[compact="true"] QScrollBar::add-line:vertical,
QFrame#sidebarFrame[compact="true"] QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}

QFrame#sidebarFrame[compact="true"] QScrollBar::add-page:vertical,
QFrame#sidebarFrame[compact="true"] QScrollBar::sub-page:vertical {
    background: transparent;
}

QLabel#sidebarBrand {
    color: #ffd54f;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
}

QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
}

QTreeWidget#navTree {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

QTreeWidget#navTree::item {
    color: #e8eaf6;
    padding: 10px 12px;
    margin: 2px 6px;
    border-radius: 8px;
    min-height: 22px;
}

QTreeWidget#navTree::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QTreeWidget#navTree::item:selected {
    background-color: #ffd54f;
    color: #1a237e;
    font-weight: 600;
}

QStackedWidget#contentStack {
    background-color: #f0f2f5;
}

QStatusBar {
    background-color: #ffffff;
    color: #5c6370;
    border-top: 1px solid #e1e4e8;
    padding: 4px 12px;
}

/* Cartes dashboard */
QFrame#dashCard {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 12px;
    padding: 0px;
}

QLabel#dashCardTitle {
    color: #5c6370;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
}

QLabel#dashCardValue {
    color: #1a237e;
    font-size: 28px;
    font-weight: 700;
}

QLabel#dashPageTitle {
    color: #1a237e;
    font-size: 22px;
    font-weight: 700;
}

QLabel#dashSubtitle {
    color: #5c6370;
    font-size: 13px;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
    gridline-color: #eef0f3;
}

QTableWidget::item {
    padding: 8px;
}

QHeaderView::section {
    background-color: #e8eaf6;
    color: #1a237e;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #c5cae9;
}

QPushButton#dashRefresh {
    background-color: #ffd54f;
    color: #1a237e;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
}

QPushButton#dashRefresh:hover {
    background-color: #ffecb3;
}

QPushButton#dashRefresh:pressed {
    background-color: #ffc107;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QFrame#dashPaths {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
    padding: 12px 16px;
}

QLabel#dashPathLabel {
    color: #5c6370;
    font-size: 12px;
}

QFrame#dashSmeFrame {
    background-color: #ffffff;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
    padding: 8px;
}

/* Cartes par position administrative */
QFrame#dashPosCard {
    background-color: #ffffff;
    border: 1px solid #d0d4dc;
    border-radius: 10px;
    min-width: 140px;
    max-width: 220px;
}

QLabel#dashPosCardTitle {
    color: #37474f;
    font-size: 11px;
    font-weight: 600;
}

QLabel#dashPosCardValue {
    color: #1a237e;
    font-size: 20px;
    font-weight: 700;
}

QScrollArea#dashPosScroll {
    background-color: transparent;
    border: 1px solid #e1e4e8;
    border-radius: 10px;
}
