}

QLabel#usersDetailSubtitle {
    font-size: 12px;
    color: #9fa8da;
}

QLabel#usersDetailSectionHeading {
    font-size: 12px;
    font-weight: 700;
    color: #9fa8da;
}

QLabel#usersDetailFormLabel {
    font-size: 13px;
    font-weight: 600;
    color: #b0bec5;
    min-width: 108px;
}

QLabel#usersDetailMetaLabel {
    font-size: 12px;
    font-weight: 600;
    color: #90a4ae;
    min-width: 108px;
}

QLabel#usersDetailMetaValue {
    font-size: 13px;
    color: #eceff1;
}

QFrame#usersDetailSeparator {
    color: #3d3e5c;
    max-height: 1px;
}

QScrollArea#usersDetailScroll {
    background: transparent;
}

QWidget#usersDetailBody {
    background: transparent;
}

QGroupBox#usersDetailGroup {
    font-weight: 600;
    color: #c5cae9;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
    margin-top: 8px;
    padding-top: 12px;
    background-color: #252636;
}

QGroupBox#usersDetailGroup::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QLabel#usersDetailStateBadge {
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#usersDetailStateBadge[stateKind="ok"] {
    background-color: #1b3d2f;
    color: #a5d6a7;
}

QLabel#usersDetailStateBadge[stateKind="locked"] {
    background-color: #4a1c1c;
    color: #ef9a9a;
}

QLabel#usersDetailStateBadge[stateKind="disabled"] {
    background-color: #2e3039;
    color: #90a4ae;
}

QPushButton#dangerButton {
    color: #ef9a9a;
    border: 1px solid #6d2c2c;
    background: #252636;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton#dangerButton:hover {
    background: #4a1c1c;
}

QPushButton#dangerButton:disabled {
    color: #616161;
    border-color: #3d3e5c;
}

QGroupBox#auditFiltersGroup {
    font-weight: 600;
    color: #9fa8da;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
    margin-top: 8px;
    padding-top: 14px;
    background-color: #252636;
}

QGroupBox#auditFiltersGroup::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #252636;
}

QGroupBox#limiteAgeFiltersGroup,
QGroupBox#limiteAgeDetailGroup {
    font-weight: 600;
    color: #9fa8da;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
    margin-top: 8px;
    padding-top: 14px;
    background-color: #252636;
}

QGroupBox#limiteAgeFiltersGroup::title,
QGroupBox#limiteAgeDetailGroup::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #252636;
}

QGroupBox#limiteAgeFiltersGroup QComboBox,
QGroupBox#limiteAgeFiltersGroup QLineEdit,
QGroupBox#limiteAgeFiltersGroup QSpinBox {
    min-height: 26px;
    padding: 1px 6px;
}

QLabel#limiteAgeFilterLabel {
    color: #9fa8da;
    font-size: 12px;
}

QLabel#limiteAgeFormLabel {
    color: #9fa8da;
    font-size: 12px;
}

QLabel#limiteAgeFormValue {
    color: #e8eaf6;
    font-size: 12px;
}

QLabel#auditResultCount {
    background-color: #2e2f45;
    color: #c5cae9;
    font-size: 12px;
    font-weight: 600;
    border-radius: 10px;
    padding: 4px 12px;
}

QTabWidget#settingsTabs::pane {
    border: 1px solid #3d3e5c;
    border-radius: 8px;
    background: #252636;
    top: -1px;
    padding: 4px;
}

QTabWidget#settingsTabs > QTabBar::tab {
    padding: 10px 18px;
    margin-right: 2px;
    background: #2e2f45;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabWidget#settingsTabs > QTabBar::tab:selected {
    background: #252636;
    color: #ffd54f;
    font-weight: 600;
}

QTabWidget#settingsTabs > QTabBar::tab:hover:!selected {
    background: #3d3e5c;
    color: #e8eaf6;
}

QLabel#lazyPagePlaceholder {
    color: #7986cb;
    font-size: 13px;
    padding: 48px;
}

QFrame#settingsActionBar {
    border-top: 1px solid #3d3e5c;
}

/* ScrollArea */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea#dashPosScroll {
    background-color: transparent;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
}

/* Misc labels */
QLabel#modalTitle { color: #c5cae9; font-weight: 700; }
QLabel#modalSubtitle { color: #7986cb; font-size: 12px; }

/* ProgressBar */
QProgressBar {
    border: none;
    background: #2e2f45;
    border-radius: 3px;
}

QProgressBar::chunk {
    background: #5c6bc0;
    border-radius: 3px;
}

/* ProgressDialog */
QProgressDialog {
    background-color: #1e1f35;
}

/* Bandeau contexte */
QFrame#contextBanner {
    background-color: #252636;
    border-bottom: 1px solid #3d3e5c;
}

QToolButton#contextBannerNavBtn {
    color: #1a237e;
    background-color: #ffdc4a;
    border: 1px solid #d4af18;
    font-weight: bold;
    font-size: 22px;
    padding: 0px 8px;
    border-radius: 6px;
    min-width: 30px;
    min-height: 30px;
}
QToolButton#contextBannerNavBtn:hover:enabled {
    background-color: #ffe77a;
    border-color: #1a237e;
}
QToolButton#contextBannerNavBtn:pressed:enabled {
    background-color: #e9c42e;
}
QToolButton#contextBannerNavBtn:disabled {
    color: #85899c;
    background-color: #303449;
    border-color: #464b61;
}

QLabel#contextBannerMois { color: #c5cae9; font-size: 13px; }
QLabel#contextBannerSource { color: #9fa8da; font-size: 12px; }
QLabel#contextBannerHint { color: #5c6370; font-size: 11px; }

QDialog#loginDialog { background-color: #0a0e27; }
QFrame#loginCard {
    background-color: #252636;
    border: 1px solid #3d3e5c;
    border-radius: 16px;
}
QLabel#loginTitle { color: #e8eaf6; }
QLabel#loginSubtitle { color: #9fa8da; }
QLineEdit#loginField {
    background-color: #2e2f45;
    color: #e8eaf6;
    border: 1px solid #3d3e5c;
}
QPushButton#loginPrimaryBtn {
    background-color: #3949ab;
    color: #ffffff;
}

QFrame#loginHeaderBar { background: transparent; }
QLabel#loginHeaderTitle {
    color: #9fa8da;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#loginCloseBtn {
    background-color: rgba(255, 255, 255, 25);
    color: #ffffff;
    border: none;
    border-radius: 13px;
    font-size: 16px;
    font-weight: 700;
    padding-bottom: 2px;
}
QPushButton#loginCloseBtn:hover { background-color: #c62828; color: #ffffff; }
QPushButton#loginCloseBtn:pressed { background-color: #8e0000; }

/* — Référentiel grades (thème sombre) — */
QWidget#GradesView {
    background-color: #1e1f2e;
}

QFrame#GradeReferentielHeader {
    background-color: #252636;
    border-bottom: 1px solid #3d3e5c;
}

QLabel#GradeReferentielTitle {
    color: #c5cae9;
    font-size: 18px;
    font-weight: 700;
}

QLabel#GradeReferentielSubtitle {
    color: #9fa8da;
    font-size: 12px;
}

QLabel#GradeReferentielCount {
    color: #7986cb;
    font-size: 11px;
}

QTableView#GradeReferentielTable {
    background-color: #252636;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
    selection-background-color: #3949ab;
    selection-color: #ffffff;
}

QFrame#GradeDetailPanel {
    background-color: #252636;
    border: 1px solid #3d3e5c;
    border-radius: 12px;
}

QLabel#GradeDetailEmpty {
    color: #7986cb;
    font-size: 13px;
}

QLabel#GradeDetailBadge {
    background-color: #3949ab;
    color: #e8eaf6;
    font-weight: 700;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 12px;
}

QLabel#GradeDetailTitle {
    color: #e8eaf6;
    font-size: 16px;
    font-weight: 700;
}

QLabel#GradeDetailCode {
    color: #9fa8da;
    font-size: 12px;
}

QFrame#GradeDetailInsigniaFrame {
    background-color: #2e2f45;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
}

QLabel#GradeDetailInsignia {
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#GradeDetailMeta,
QLabel#GradeDetailPathHint {
    color: #b0bec5;
    font-size: 11px;
}

QPushButton#GradeDetailPrimaryBtn,
QPushButton#GradeToolbarPrimaryBtn {
    background-color: #3949ab;
    color: #ffffff;
    font-weight: 600;
    border-radius: 8px;
    border: none;
}

QFrame#GradeEditPreview {
    background-color: #2e2f45;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
}

QPushButton[destructive="true"],
QToolButton[destructive="true"] {
    color: #ef9a9a;
    border: 1px solid #c62828;
    background: #3d2020;
    border-radius: 8px;
}

QPushButton[healthState="error"] {
    color: #ef9a9a;
    border: 1px solid #c62828;
    background: #3d2020;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[healthState="ok"] {
    color: #a5d6a7;
    border: 1px solid #2e7d32;
    background: #1e2e1e;
    border-radius: 8px;
}

/* Liste des présents */
QWidget#listePresentQuickPanel {
    background-color: #252636;
    border-right: 1px solid #3d3e5c;
}

QTextBrowser#listePresentPreview,
QTextBrowser#paperPreview {
    background-color: #d0d4dc;
    color: #212121;
    border: 1px solid #3d3e5c;
    border-radius: 6px;
    padding: 4px;
}
