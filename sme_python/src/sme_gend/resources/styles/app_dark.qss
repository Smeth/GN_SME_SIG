    font-size: 13px;
    padding: 4px 9px;
    border-radius: 5px;
    background-color: #2e2f45;
    border: 1px solid #3d3e5c;
    min-width: 28px;
}

QToolButton#periodNavBtn:hover {
    background-color: #3d3e5c;
    border-color: #7986cb;
}

QLabel#periodMonthLabel {
    color: #c5cae9;
    font-size: 14px;
    font-weight: 700;
    padding: 0 6px;
}

QLabel#periodStatutLabel {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
}

/* Liste générale */
QFrame#personnelListTopBar {
    background-color: #252636;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
    padding: 8px 10px;
}

QLabel#personnelListCounter { color: #7986cb; font-size: 12px; }

QLabel#editionSmeCounter {
    color: #c5cae9;
    font-size: 15px;
    font-weight: 600;
    padding: 2px 0;
}

QLabel#editionSmeCounterDetail {
    color: #9fa8da;
    font-size: 12px;
    padding: 0 2px 4px 2px;
}

/* Gains & pertes */
QLabel#gainPerteDesc {
    color: #9fa8da;
    font-size: 13px;
}

QFrame#gainPerteToolbar {
    background-color: #252636;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
}

QPushButton#gainPerteBtnPrimary {
    background-color: #3949ab;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton#gainPerteBtnPrimary:hover {
    background-color: #5c6bc0;
}

QPushButton#gainPerteBtnPrimary:disabled {
    background-color: #3d3e5c;
    color: #7986cb;
}

QFrame#gainPerteTopBar {
    background-color: #252636;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
}

QComboBox#gainPertePeriodCombo {
    min-height: 28px;
    padding: 2px 8px;
}

QLineEdit#gainPerteSearch {
    min-height: 28px;
    padding: 2px 8px;
}

QPushButton#gainPerteFilterBtn {
    border: 1px solid #3d3e5c;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #2a2b3d;
    color: #c5cae9;
}

QPushButton#gainPerteFilterBtn:hover {
    background-color: #353650;
}

QPushButton#gainPerteFilterBtn:checked {
    background-color: #3949ab;
    color: #ffffff;
    border-color: #5c6bc0;
    font-weight: 600;
}

QLabel#gainPerteStatChip {
    margin-right: 4px;
}

QFrame#gainPerteSep {
    background-color: #3d3e5c;
    min-width: 1px;
    max-width: 1px;
}

QLabel#gainPerteCount {
    color: #7986cb;
    font-size: 12px;
}

QLabel#gainPerteSummary {
    color: #c5cae9;
    font-size: 13px;
    padding: 6px 10px;
    background-color: #252640;
    border-radius: 6px;
}

QLabel#gainPerteLockBanner {
    color: #ef9a9a;
    font-size: 12px;
    padding: 6px 10px;
    background-color: #3d2020;
    border-radius: 6px;
    border: 1px solid #c62828;
}

QFrame#avancementHeader {
    background-color: #252640;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
}

QLabel#avancementSectionTitle {
    color: #c5cae9;
}

QTabWidget#avancementTabs::pane {
    border: 1px solid #3d3e5c;
    border-radius: 8px;
    background: #1e1f33;
    top: -1px;
    padding: 8px;
}

QTabWidget#avancementTabs > QTabBar::tab {
    background: #252640;
    color: #c5cae9;
    border: 1px solid #3d3e5c;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 18px;
    margin-right: 4px;
    font-weight: 600;
    min-width: 120px;
}

QTabWidget#avancementTabs > QTabBar::tab:selected {
    background: #3949ab;
    color: #ffffff;
}

QTabWidget#avancementTabs > QTabBar::tab:hover:!selected {
    background: #2a2b40;
}

QTableWidget#avancementTable {
    background-color: #1e1f33;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
    gridline-color: #3d3e5c;
    font-size: 13px;
    color: #e8eaf6;
}

QTableWidget#avancementTable::item {
    padding: 8px 10px;
}

QTableWidget#avancementTable::item:selected {
    background-color: #3949ab;
    color: #ffffff;
}

QTableWidget#avancementTable QHeaderView::section {
    background-color: #252640;
    color: #c5cae9;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #3d3e5c;
    border-bottom: 2px solid #3949ab;
    font-weight: 600;
}

QLabel#avancementLookupCard {
    background-color: #252640;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
    padding: 16px 18px;
    min-height: 120px;
    color: #e8eaf6;
}

QLabel#editionFilterHint {
    color: #7986cb;
    font-size: 11px;
}

QToolButton#personnelFiltersToggle {
    color: #c5cae9;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
}

QToolButton#personnelFiltersToggle:hover {
    background-color: #3d3e5c;
    border-color: #5c6bc0;
}

QToolButton#personnelRefreshBtn {
    padding: 6px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
}

QToolButton#personnelRefreshBtn:hover {
    background-color: #3d3e5c;
    border-color: #5c6bc0;
}

QWidget#personnelFilterPanel QGroupBox {
    font-weight: 600;
    color: #9fa8da;
    border: 1px solid #3d3e5c;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px 14px 14px 14px;
    background-color: #252636;
}

QWidget#personnelFilterPanel QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #252636;
}

QWidget#personnelFilterPanel QComboBox {
    padding: 4px 8px;
    min-height: 26px;
}

/* Paramètres */
QGroupBox#settingsPathsGroup {
    font-weight: 600;
    color: #9fa8da;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
    margin-top: 8px;
    padding-top: 12px;
    background-color: #252636;
}

QGroupBox#settingsPathsGroup::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #252636;
}

QLabel#settingsPathsHint { color: #7986cb; font-size: 12px; margin-bottom: 6px; }

QGroupBox#settingsPathsGroup QSpinBox,
QGroupBox#settingsPathsGroup QComboBox,
QGroupBox#settingsPathsGroup QLineEdit {
    min-height: 30px;
}

QLabel#usersAuthFormLabel {
    color: #b0bec5;
    font-size: 13px;
    min-height: 28px;
