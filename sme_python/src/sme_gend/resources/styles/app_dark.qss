}

QGroupBox#usersAuthSection {
    font-weight: 600;
    color: #9fa8da;
    border: 1px solid #3d3e5c;
    border-radius: 10px;
    margin-top: 4px;
    padding-top: 14px;
    background-color: #2a2b3d;
}

QGroupBox#usersAuthSection::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    background-color: #2a2b3d;
}

QScrollArea#usersAuthConfigScroll {
    background: transparent;
    border: none;
}

QWidget#usersAuthConfigHost {
    background: transparent;
}

QFrame#usersAuthSaveBar {
    background: transparent;
